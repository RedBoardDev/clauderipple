{
  "name": "@clauderipple/app",
  "version": "0.12.14",
  "private": true,
  "description": "ClaudeRipple Electron tray for Windows and Linux. Hosts the dashboard even when the router is down and shows chain health.",
  "license": "GPL-3.0-only",
  "author": "pbj",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mts",
    "dist:win": "npm run icons && npm run build && electron-builder --win --dir -c.directories.output=release-dev",
    "release:win": "npm run icons && npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clauderipple.app",
    "productName": "ClaudeRipple",
    "electronVersion": "38.8.6",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../router/src",
        "to": "clauderipple/packages/router/src"
      },
      {
        "from": "../cli/src",
        "to": "clauderipple/packages/cli/src"
      },
      {
        "from": "../ui",
        "to": "clauderipple/packages/ui"
      },
      {
        "from": "../mod",
        "to": "clauderipple/packages/mod",
        "filter": [
          "**/*",
          "!.claude-plugin/types/**"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "clauderipple/LICENSE"
      },
      {
        "from": "../../README.md",
        "to": "clauderipple/README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClaudeRipple",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
